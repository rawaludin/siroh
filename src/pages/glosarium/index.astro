---
const base = "/siroh/";
import Base from "../../layouts/Base.astro";
import Arabic from "../../components/Arabic.astro";
import { getCollection } from "astro:content";

const glosarium = (await getCollection("glosarium")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Glosarium — Sirah Nabawiyah" description="Kamus istilah dalam Sirah Nabawiyah." total={glosarium.length}>
  <main class="page">
    <a href={`${base}`} class="page__back">← Kembali ke garis waktu</a>
    <h1 class="page__title">Glosarium</h1>
    <p class="page__subtitle">Kamus istilah-istilah penting dalam Sirah Nabawiyah.</p>

    <input
      type="search"
      id="glossary-search"
      class="search"
      placeholder="Cari istilah…"
      aria-label="Cari istilah"
    />

    <div class="list" id="glossary-list">
      {glosarium.map((g) => (
        <a href={`${base}glosarium/${g.id}/`} class="card bouncy" data-term={g.data.term} data-reveal>
          <h3 class="card__term">{g.data.term}</h3>
          <span class="card__term-ar"><Arabic text={g.data.termAr} /></span>
          <p class="card__def">{g.data.definition}</p>
        </a>
      ))}
    </div>
  </main>
</Base>

<style>
  .page { max-width: 900px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
  .page__back { font-size: 0.9rem; }
  .page__title { margin: 1rem 0 0; }
  .page__subtitle { margin: 0 0 1.25rem; color: var(--muted); }
  .search {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 1rem;
    margin-bottom: 1.25rem;
  }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .card:hover { text-decoration: none; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08); }
  .card__term { margin: 0; font-size: 1.05rem; }
  .card__term-ar { color: var(--muted); font-size: 1.2rem; margin: 0.1rem 0 0.4rem; }
  .card__def { margin: 0; color: var(--muted); font-size: 0.9rem; }
</style>

<script>
  const input = document.getElementById("glossary-search") as HTMLInputElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-term]"));

  input.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    for (const card of cards) {
      card.hidden = q !== "" && !(card.dataset.term ?? "").toLowerCase().includes(q);
    }
  });
</script>
