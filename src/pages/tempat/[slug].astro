---
import Base from "../../layouts/Base.astro";
import Arabic from "../../components/Arabic.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const tempat = await getCollection("tempat");
  return tempat.map((t) => ({ params: { slug: t.id }, props: { entry: t } }));
}

const { entry } = Astro.props;

const events = await getCollection("events");
const titleBySlug = new Map(events.map((e) => [e.slug, e.data.title]));
const relatedEvents = (entry.data.relatedEvents ?? []).map((slug) => ({ slug, title: titleBySlug.get(slug) ?? slug }));
---

<Base title={`${entry.data.name} — Tempat Sirah Nabawiyah`} description={entry.data.description}>
  <main class="detail">
    <a href="/tempat/" class="detail__back">← Kembali ke daftar tempat</a>
    <article class="detail__article">
      <header class="detail__header">
        <h1 class="detail__title">{entry.data.name}</h1>
        <span class="detail__name-ar"><Arabic text={entry.data.nameAr} /></span>
        {entry.data.location && <p class="detail__location">Lokasi: {entry.data.location}</p>}
      </header>

      <p class="detail__desc">{entry.data.description}</p>
    </article>

    {relatedEvents.length > 0 && (
      <nav class="related">
        <h2>Peristiwa terkait</h2>
        <ul>
          {relatedEvents.map((r) => (
            <li><a href={`/events/${r.slug}/`}>{r.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </main>
</Base>

<style>
  .detail { max-width: 760px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
  .detail__back { font-size: 0.9rem; }
  .detail__header { border-left: 4px solid var(--secondary); padding-left: 1rem; margin: 1.25rem 0; }
  .detail__title { margin: 0.3rem 0; }
  .detail__name-ar { display: block; color: var(--muted); font-size: 1.5rem; margin-bottom: 0.5rem; }
  .detail__location { color: var(--muted); font-size: 0.9rem; margin: 0.25rem 0 0; }
  .detail__desc { font-size: 1.05rem; margin-top: 1.25rem; }
  .related { margin-top: 2rem; }
  .related h2 { font-size: 1.1rem; }
  .related ul { padding-left: 1.2rem; color: var(--muted); }
</style>
